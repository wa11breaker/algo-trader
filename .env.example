# Create an app at https://account.upstox.com/developer/apps
UPSTOX_API_KEY=your_api_key
UPSTOX_API_SECRET=your_api_secret
UPSTOX_REDIRECT_URI=http://127.0.0.1:8765/callback

# Fyers (live data for paper trading). Create an app at https://myapi.fyers.in/dashboard
# and set its redirect URL to exactly FYERS_REDIRECT_URI.
FYERS_APP_ID=XXXXXXXXXX-100
FYERS_SECRET_ID=your_secret
FYERS_REDIRECT_URI=http://127.0.0.1:8766/callback

# Headless Fyers login for servers (`algo fyers-login --totp`). Enable "External 2FA TOTP" in the
# Fyers app/web (My Account > Security) and paste the secret key shown with the QR code.
FYERS_CLIENT_ID=
FYERS_PIN=
FYERS_TOTP_SECRET=
